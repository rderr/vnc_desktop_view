{
  "name": "vnc-desktop-view",
  "displayName": "Remote Desktop View",
  "description": "See and control your remote Windows machine's desktop, with sound and clipboard, in an editor tab over your existing Remote Tunnels / Remote-SSH connection",
  "version": "0.2.0",
  "preview": true,
  "license": "MIT",
  "author": "Rob Derr <robjderr@gmail.com>",
  "publisher": "RobDerr",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/rderr/vnc_desktop_view"
  },
  "homepage": "https://github.com/rderr/vnc_desktop_view#readme",
  "bugs": {
    "url": "https://github.com/rderr/vnc_desktop_view/issues"
  },
  "keywords": [
    "remote desktop",
    "remote development",
    "remote tunnels",
    "ssh",
    "screen sharing",
    "h.264",
    "windows"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "vncDesktopView.open",
        "title": "Open Desktop",
        "category": "Remote Desktop View"
      }
    ],
    "configuration": {
      "title": "Remote Desktop View",
      "properties": {
        "vncDesktopView.commandKey": {
          "type": "string",
          "enum": [
            "ctrl",
            "windows"
          ],
          "enumDescriptions": [
            "⌘ acts as Ctrl on the remote, so ⌘C, ⌘V, ⌘Z… work like on the Mac.",
            "⌘ is sent as the Windows key."
          ],
          "default": "ctrl",
          "markdownDescription": "Mac only: what the ⌘ (Command) key sends to the remote desktop."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs && node scripts/build-notices.mjs",
    "vscode:prepublish": "npm run build",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "package": "node scripts/package.mjs",
    "publish": "node scripts/package.mjs --publish"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "opus-decoder": "0.7.11",
    "typescript": "^5.9.0"
  }
}
